---
import site from '../content/site.json';
---

<ul class="social-media-list">
  {
    site.github_username && (
      <li>
        <a href={`https://github.com/${site.github_username}`} rel="me">
          <svg class="svg-icon">
            <use xlink:href="/assets/minima-social-icons.svg#github" />
          </svg>{' '}
          <span class="username">{site.github_username}</span>
        </a>
      </li>
    )
  }
  {
    site.linkedin_username && (
      <li>
        <a
          href={`https://www.linkedin.com/in/${site.linkedin_username}`}
          rel="me"
        >
          <svg class="svg-icon">
            <use xlink:href="/assets/minima-social-icons.svg#linkedin" />
          </svg>{' '}
          <span class="username">{site.linkedin_username}</span>
        </a>
      </li>
    )
  }
  {
    site.twitter_username && (
      <li>
        <a href={`https://www.twitter.com/${site.twitter_username}`} rel="me">
          <svg class="svg-icon">
            <use xlink:href="/assets/minima-social-icons.svg#twitter" />
          </svg>{' '}
          <span class="username">{site.twitter_username}</span>
        </a>
      </li>
    )
  }
  {
    site.rss && (
      <li>
        <a href="/feed.xml">
          <svg class="svg-icon">
            <use xlink:href="/assets/minima-social-icons.svg#rss" />
          </svg>{' '}
          <span>{site.rss}</span>
        </a>
      </li>
    )
  }
  {
    site.stackoverflow_username && (
      <li>
        <a
          href={`https://stackoverflow.com/users/${site.stackoverflow_username}`}
          rel="me"
        >
          <svg class="svg-icon icon-my stackoverflow">
            <use xlink:href="/assets/images/stackOverflow.svg" />
          </svg>{' '}
          <span class="username">{site.stackoverflow_username}</span>
        </a>
      </li>
    )
  }
  {
    site.kaggle_username && (
      <li>
        <a href={`https://kaggle.com/${site.kaggle_username}`} rel="me">
          <span class="black svg-icon">k</span>{' '}
          <span class="username">{site.kaggle_username}</span>
        </a>
      </li>
    )
  }
  <li>
    <a
      href="https://link477255648240.wordpress.com/contact/"
      target="_blank"
      rel="noopener noreferrer"
      ><svg class="svg-icon icon-my email"
        ><use xlink:href="/assets/images/envolope.svg"></use></svg
      > Email</a
    >
  </li>
  <li>
    <a
      href={`https://datacamp.com/profile/${site.datacamp_username}`}
      target="_blank"
      rel="noopener noreferrer me"
      ><img
        src="/assets/images/datacamp-brand-green.png"
        alt="DataCamp"
        class="icon-my"
        loading="lazy"
      />
      <span>{site.datacamp_username}</span></a
    >
  </li>
  {
    site.credly_username && (
      <li>
        <a
          href={`https://www.credly.com/users/${site.credly_username}`}
          target="_blank"
          rel="noopener noreferrer me"
        >
          <svg class="icon-my credly svg-icon">
            <use xlink:href="/assets/images/credly.svg" />
          </svg>{' '}
          <span>{site.credly_username}</span>
        </a>
      </li>
    )
  }
  {
    site.exercism_username && (
      <li>
        <a
          href={`https://exercism.org/profiles/${site.exercism_username}`}
          target="_blank"
          rel="noopener noreferrer me"
        >
          <img
            src="/assets/images/exercism.webp"
            alt="Exercism"
            width="16"
            height="16"
            loading="lazy"
            class="icon-my"
          />{' '}
          <span>{site.exercism_username}</span>
        </a>
      </li>
    )
  }
</ul>
