---
import site from '../content/site.json';
import tomPic from '../assets/tom.jpg';
import Picture from 'astro/components/Picture.astro';
const mainClass = `imgmain${site.show_story ? ' story' : ''}`;
---

<Picture
  class={mainClass}
  src={tomPic}
  alt="Tom."
  formats={['jpg', 'webp']}
  width={250}
  height={250}
  loading="eager"
/>
