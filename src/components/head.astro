---
import site from '../content/site.json';
const {
  title = 'Thomas Fishwick',
  description = site.description,
  image = site.logo,
  twitter = 'summary_large_image',
  date = '',
  layout='page',
  css_file= '',
  js_file='',
  is_home=false,
  ...props
} = Astro.props;
const url = Astro.url.pathname;
---

<head>
  <meta charset="utf-8" />
  <!-- SEO stuff -->
  <title>{title} | {site.title}</title>
  <meta property="og:title" content={title} />
  <meta name="twitter:title" content={title} />
  <meta name="generator" content={Astro.generator} />
  <meta name="author" content={site.author.name} />
  <meta property="og:locale" content={site.lang} />
  <meta name="description" content={description} />
  <meta name="twitter:description" content={description} />
  <link rel="canonical" href={url} />
  <meta property="og:url" content={url} />
  <meta name="twitter:url" content={url} />
  <meta property="og:site_name" content={title} />
  <meta property="og:image" content={image.src} />
  {image.height && <meta property="og:image:height" content={image.height} />}
  {image.width && <meta property="og:image:width" content={image.width} />}
  {
    image.alt && (
      <>
        <meta property="og:image:alt" content={image.alt} />
        <meta name="twitter:image:alt" content={image.alt} />
      </>
    )
  }
  <meta name="twitter:card" content={twitter} />
  <meta name="twitter:image" content={image.src} />
  {
    date ? (
      <>
        <meta property="og:type" content="article" />
        <meta property="article:published_time" content={date} />
      </>
    ) : (
      <meta property="og:type" content="website" />
    )
  }
  <meta name="twitter:description" content={site.description}/>
  <meta name="twitter:dnt" content="on"/>
  {site.twitter_username && <meta name="twitter:creator" content={`@${ site.twitter_username}`}/>}
  <!-- For Slack's metadata-->
  <link rel="alternate" type="application/json+oembed" href="/oembed.json" title="Toms oEmbed Profile"/>
  <!-- Blog roll-->
  <link rel="blogroll" type="application/xml" title="Blogroll" href="/blogroll.xml" />
  <!-- Facebook instant articles-->
  <meta property="op:markup_version" content="v1.0"/>
  <meta property="fb:article_style" content="myarticlestyle"/>
  <!-- <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": {% if page.layout == 'post' %}"BlogPosting"{% else %}"WebSite"{% endif %},
      "author": {"@type":"Person","name":"{{ site.author.name }}"},
      "dateModified": "{{ page.last_modified_at | default: page.date | date_to_xmlschema }}",
      {%- if page.date %}"datePublished": "{{ page.date | date_to_xmlschema }}",{%- endif %}
      "description": {% if page.description %}"{{ page.description | strip_html | normalize_whitespace }}"{% elsif page.excerpt %}"{{ page.excerpt | strip_html | normalize_whitespace }}"{% else %}"{{ site.description | strip_html | normalize_whitespace }}"{% endif %},
      "headline": "{{ page.title }}",
      {%- if page.layout == 'post' %}"mainEntityOfPage": {"@type": "WebPage","@id": "{{ page.url | absolute_url}}}",{% endif %}
      "publisher": {"@type": "Organization","logo": "{{ site.logo | absolute_url }}"},
      "name": "{{ site.author.name }}",
      "url": "{{ site.url }}"
    }
  </script> -->

  <!-- CSS only -->
  <link rel="preconnect" href="/assets/css/my-navbar.css"/>
  <link rel="stylesheet" href="/assets/css/my-navbar.css"/>
  <link rel="preload" href="/assets/css/styles.css" as="style" onload="this.rel='stylesheet'"/>
  <noscript><link rel="stylesheet" href="/assets/css/styles.css"/></noscript>
  <script src="/assets/js/dark_mode_picker.js" async="async"></script>

  {css_file &&
  <link rel="preload" href={`/assets/css/${css_file}`} as="style" onload="this.rel='stylesheet'"/>
  <noscript><link rel="stylesheet" href={`/assets/css/${css_file}`}/></noscript>
  }

  {js_file && <script src={`/assets/js/${js_file.path }`} async={js_file.async ? 'async' : 'false'} defer="js_file.defer ? 'defer' : 'false" type="js_file.module ? 'module' : 'false'"></script>}

  {(layout === 'post' && site.show_likes) && <>
  <!-- For the like button -->
  <script src="/assets/js/iine.mini.js"></script>
  </>}

  <meta name="color-scheme" content="light dark"/>
  <!--Icons-->
  <link rel="icon" href="/assets/images/link477.png"/>
  <link rel="icon" href="/assets/images/icons/favicon-16x16.png" sizes="16x16" type="image/png"/>
  <link rel="icon" href="/assets/images/icons/favicon-32x32.png" sizes="32x32" type="image/png"/>
  <link rel="apple-touch-icon" href="/assets/images/icons/apple-touch-icon.png" sizes="180x180"/>
  <link rel="icon" href="/assets/images/icons/android-chrome-192x192.png" sizes="192x192" type="image/png"/>
  <link rel="icon" href="/assets/images/icons/android-chrome-256x256.png" sizes="256x256" type="image/png"/>
  <link rel="icon" href="/assets/images/icons/android-chrome-512x512.png" sizes="512x512" type="image/png"/>
  <meta name="msapplication-config" content="/browserconfig.xml"/>
  <meta name="mobile-web-app-capable" content="yes" />

  {is_home && <link rel="manifest" href="/site.webmanifest"/>}
  <meta name="theme-color" content="#ffffff"/>
  <link rel="mask-icon" href="/assets/images/icons/maskicon.svg" color="#ffffff"/>

  <!--Feeds-->
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="Atom 0.3"/>
  <link href="{{ site.site_url }}/feed_rss.xml" rel="alternate" title="RSS" type="application/rss+xml"/>
  <link rel="alternate" type="application/json" title="JSON Feed" href="/feed.json" />

  <!--Misc-->
  <meta name="facebook-domain-verification" content="wzpmg9812dx4tnuv0mo7m580wp8r75" />
  <meta name="scanfyi-verification" content="ac880ff3f558bf4b818812597118dc55b429fe310c0b0330d5510c901a0af7fa"/>
  <meta name="robots" content="DisallowAITraining"/>
  <link type="text/plain" rel="author" href="/humans.txt"/>
  <link rel="meta" type="application/rdf+xml" title="FOAF" href="/foaf.rdf"/>
  <link rel="alternate" href="https://link477.com/" hreflang="x-default" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml"/>
  <link rel="webmention" href="https://webmention.io/link477.com/webmention"/>
  <link rel="search" type="application/opensearchdescription+xml" href="/opensearch.xml" title="Link477 Search"/>
  <link rel="human-json" href="/human.json"/>
</head>
