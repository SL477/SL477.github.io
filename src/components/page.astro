---
import DefaultModified from './default_modified.astro';
const { title } = Astro.props;
---

<DefaultModified title={title}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</DefaultModified>
