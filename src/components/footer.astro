---
import site from '../content/site.json';
import Social from './social.astro';
---

<footer class="site-footer h-card">
  <a class="u-url u-uid" href={site.site_url} hidden="hidden">My Site</a>

  <picture hidden="hidden">
    <source srcset={site.logo.webp} type="image/webp" />
    <source srcset={site.logo.src} type="image/png" />
    <img
      src={site.logo.src}
      alt={site.logo.alt}
      height="50"
      width="50"
      class="u-logo"
      loading="lazy"
    />
  </picture>

  <div class="wrapper">
    <h2 class="footer-heading p-name">
      <picture>
        <source srcset={site.photo_webp} type="image/webp" />
        <source srcset={site.photo} type="image/jpg" />
        <img src={site.photo} alt="" class="u-photo img-main-small" />
      </picture>{site.title}
    </h2>

    <div class="footer-col-wrapper">
      <div class="footer-col footer-col-4">
        <Social />
      </div>

      <div class="footer-col footer-col-3">
        <p class="p-note">{site.description}</p>
      </div>
      <div class="footer-col footer-col-3">
        <a href="/sitemap.xml">
          <svg class="svg-icon icon-my sitemap"
            ><use xlink:href="/assets/images/sitemap.svg"></use></svg
          >Site Map
        </a>
      </div>
      <div class="footer-col footer-col-3">
        <a href="/">
          <img
            src="/assets/images/human.svg"
            alt="Human made."
            width="88"
            height="31"
          />
        </a>
      </div>
    </div>
  </div>
</footer>
