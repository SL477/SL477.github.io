---
import DefaultModified from './default_modified.astro';
const {frontmatter} = Astro.props;
---

<DefaultModified title={'test'}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{frontmatter.title}</h1>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</DefaultModified>
