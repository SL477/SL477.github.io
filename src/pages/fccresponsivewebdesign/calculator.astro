---
import Page from '../../layouts/page.astro';
const frontmatter = {
  title: 'FCC - Calculator',
  last_modified_at: '2025-11-28',
};
---

<style>
  #display {
    border-color: light-dark(black, white);
    border-style: solid;
  }

  td button {
    width: 100%;
  }

  table {
    margin-left: auto;
    margin-right: auto;
  }
</style>

<Page frontmatter={frontmatter}>
  <div class="container-fluid">
    <table class="table-bordered">
      <tbody>
        <tr>
          <td id="display" colspan="4">&nbsp;</td>
        </tr>
        <tr>
          <td id="formula" colspan="4">&nbsp;</td>
        </tr>
        <tr>
          <td colspan="2">
            <button type="button" id="equals">=</button>
          </td>
          <td colspan="2">
            <button type="button" id="clear">AC</button>
          </td>
        </tr>
        <tr>
          <td><button type="button" id="seven">7</button></td>
          <td><button type="button" id="eight">8</button></td>
          <td><button type="button" id="nine">9</button></td>
          <td>
            <button type="button" id="divide">/</button>
          </td>
        </tr>
        <tr>
          <td><button type="button" id="four">4</button></td>
          <td><button type="button" id="five">5</button></td>
          <td><button type="button" id="six">6</button></td>
          <td>
            <button type="button" id="multiply">x</button>
          </td>
        </tr>
        <tr>
          <td><button type="button" id="one">1</button></td>
          <td><button type="button" id="two">2</button></td>
          <td><button type="button" id="three">3</button></td>
          <td>
            <button type="button" id="subtract">-</button>
          </td>
        </tr>
        <tr>
          <td colspan="2">
            <button type="button" id="zero">0</button>
          </td>
          <td>
            <button type="button" id="decimal">.</button>
          </td>
          <td>
            <button type="button" id="add">+</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</Page>

<script>
  let lastOperator = '';
  let operatorRun = 0;
  const formulaTD = document.getElementById('formula') as HTMLTableCellElement;
  const displayTD = document.getElementById('display') as HTMLTableCellElement;

  function equals() {
    console.log('equals');
    if (formulaTD && displayTD) {
      const txt = formulaTD.textContent;
      displayTD.textContent = eval(txt);
      operatorRun = 0;
      lastOperator = '';
      formulaTD.textContent = '0';
    }
  }
  document.getElementById('equals')?.addEventListener('click', equals);

  function number(num: number) {
    console.log(num);
    if (formulaTD && displayTD) {
      if (formulaTD.textContent == '0') {
        formulaTD.textContent = num.toString();
      } else {
        formulaTD.textContent += num.toString();
      }

      if (
        displayTD.textContent == '0' ||
        (lastOperator != '' && lastOperator != '.')
      ) {
        displayTD.textContent = num.toString();
      } else {
        displayTD.textContent += num.toString();
      }
      if (lastOperator == '.') {
      } else {
        lastOperator = '';
      }
      operatorRun = 0;
    }
  }

  const nums = {
    zero: 0,
    one: 1,
    two: 2,
    three: 3,
    four: 4,
    five: 5,
    six: 6,
    seven: 7,
    eight: 8,
    nine: 9,
  };
  Object.entries(nums).forEach(([k, v]) => {
    document.getElementById(k)?.addEventListener('click', () => number(v));
  });

  function operator(op: string) {
    if (formulaTD && displayTD) {
      if (lastOperator == '.') {
        lastOperator = '';
      }
      console.log(op);
      if (formulaTD.textContent == '0') {
        formulaTD.textContent = displayTD.textContent;
      }

      if (op == '-' && lastOperator == '-') {
      } else {
        if (lastOperator == '' || (op == '-' && lastOperator != '-')) {
          formulaTD.textContent += op;
        } else {
          const txt = formulaTD.textContent;
          formulaTD.textContent =
            txt.substring(0, txt.length - operatorRun) + op;
        }
        displayTD.textContent = op;
        lastOperator = op;
        operatorRun += 1;
      }
    }
  }

  const operators = {
    multiply: '*',
    divide: '/',
    subtract: '-',
    add: '+',
  };
  Object.entries(operators).forEach(([k, v]) => {
    document.getElementById(k)?.addEventListener('click', () => operator(v));
  });

  function decimal() {
    if (displayTD && formulaTD) {
      if (lastOperator == '.') {
      } else {
        formulaTD.textContent += '.';
        displayTD.textContent += '.';
      }
      lastOperator = '.';
      operatorRun = 0;
    }
  }
  document.getElementById('decimal')?.addEventListener('click', decimal);

  function clearer() {
    if (formulaTD && displayTD) {
      console.log('clear');
      formulaTD.textContent = '0';
      displayTD.textContent = '0';
      lastOperator = '';
      operatorRun = 0;
    }
  }
  document.getElementById('clear')?.addEventListener('click', clearer);
</script>
