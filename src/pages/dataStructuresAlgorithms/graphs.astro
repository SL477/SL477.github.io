---
import Page from '../../layouts/page.astro';
const frontmatter = { title: 'Graphs', last_modified_at: '2025-02-01' };
---

<Page frontmatter={frontmatter}>
  <p>
    My answers to the exercises in <a
      href="https://github.com/GauravWalia19/Free-Algorithms-Books/blob/master/Library/src/JAVASCRIPT/Data-Structures-%26-Algorithms-with-JavaScript.pdf"
      >Algorithms &amp; Data Structures with JS</a
    >
  </p>

  <div id="example"></div>

  <fieldset>
    <legend>Exercise 2:</legend>
    <label for="filename">File Name:</label>
    <input
      id="filename"
      name="filename"
      type="text"
      class="form-control"
      value="test.txt"
    />
    <label for="text">Text:</label>
    <textarea id="text" name="text" class="form-control" rows="10"></textarea>
    <button type="button" class="btn btn-primary" id="download">Download</button
    >
  </fieldset>

  <fieldset>
    <legend>Exercise 3:</legend>
    <label for="fileLoad">Upload File</label>
    <input id="fileLoad" name="fileLoad" type="file" class="form-control" />
    <div id="output"></div>
  </fieldset>

  <legend>Exercise 4:</legend>
  <div id="ex4"></div>
</Page>

<script>
  import { undefined } from 'astro:schema';

  class Vertex {
    label: string;
    constructor(label: string) {
      this.label = label;
    }
  }

  class Graph {
    vertices: number;
    vertexList: string[] = [];
    edges: number = 0;
    adj: number[][] = [];
    marked: boolean[] = [];
    edgeTo: number[] = [];
    constructor(v: number) {
      this.vertices = v;
      // initialise adjacency lists
      for (let i = 0; i < this.vertices; ++i) {
        this.adj[i] = [];
      }

      // initialise visited flags
      this.marked = Array(this.vertices).fill(false);
    }

    /** Add an undirected edge (v, w) */
    addEdge(v: number, w: number) {
      this.adj[v].push(w);
      this.adj[w].push(v);
      this.edges++;
    }

    /** Classic “text” representation of the adjacency matrix (used for debugging) */
    showGraphOld() {
      let ret = '';
      for (let i = 0; i < this.vertices; ++i) {
        ret += '<p>' + i.toString() + ' -> ';
        for (let j = 0; j < this.vertices; ++j) {
          if (this.adj[i][j]) {
            ret += this.adj[i][j] + ' ';
          }
        }
        ret += '</p>';
      }
      return ret;
    }

    /** Friendly HTML list that shows each vertex together with the names of its neighbours */
    showGraph() {
      let ret = '<ul>';
      const visited = [];
      for (let i = 0; i < this.vertices; i++) {
        ret += '<li>' + this.vertexList[i] + ' -> ';
        visited.push(this.vertexList[i]);
        let delim = '';
        //console.log(this.adj[i]);
        /*for (let j = 0; j < this.vertices; j++) {
          //console.log(this.adj[i][j], this.vertexList[j]);
          if (this.adj[i][j] != undefined) {
              if (visited.indexOf(this.vertexList[j]) < 0) {
                  ret += delim + this.vertexList[j];
                  delim = ', ';
              }
          }
      }*/
        for (let j = 0; j < this.adj[i].length; j++) {
          const s = this.vertexList[this.adj[i][j]];
          if (s) {
            if (visited.indexOf(s) < 0) {
              ret += delim + s;
              delim = ', ';
            }
          }
        }
        ret += '</li>';
      }
      //console.log('visited',visited);
      ret += '</ul>';
      return ret;
    }

    /** Save the graph in a simple “comma‑separated” format that the UI uses */
    saveFormat() {
      let ret = '';
      let delim = '';
      this.vertexList.forEach((v) => {
        ret += delim + v;
        delim = ',';
      });

      for (let i = 0; i < this.vertices; ++i) {
        //let temp = '\n' + i
        for (let j = 0; j < this.vertices; ++j) {
          if (this.adj[i][j] && this.adj[i][j]) {
            if (this.adj[i][j] > i) {
              ret += '\n' + i + ',' + this.adj[i][j];
            }
          }
        }
      }
      return ret;
    }

    /** Depth‑first traversal starting at vertex `v`.  Marks all reachable vertices. */
    dfs(v: number) {
      //depth first search
      this.marked[v] = true;
      if (this.adj[v]) {
        console.log('Visited vertex:', v);
      }
      if (this.adj[v]) {
        this.adj[v].forEach((w) => {
          if (!this.marked[w]) {
            this.dfs(w);
          }
        });
      }
    }

    /** Breadth‑first traversal starting at vertex `s`.  Returns a small report. */
    bfs(s: number): string {
      //breadth first search
      const queue: number[] = [];
      this.marked[s] = true;
      queue.push(s); //add to back of queue
      let ret = '';
      while (queue.length > 0) {
        const v = queue.shift() as number; //remove from front of queue
        ret += `<p>Visited vertex: ${v}</p>`;

        this.adj[v]?.forEach((w) => {
          if (!this.marked[w]) {
            this.edgeTo[w] = v;
            this.marked[w] = true;
            queue.push(w);
          }
        });
      }
      return ret;
    }

    /** Reconstruct the path from the source (vertex 0) to `v` using `edgeTo`. */
    pathTo(v: number): number[] | undefined {
      const source = 0;
      if (!this.hasPathTo(v)) {
        return;
      }
      const path: number[] = [];
      for (let i = v; i !== source; i = this.edgeTo[i]) {
        path.push(i);
      }
      path.push(source);
      return path;
    }

    /** True iff vertex `v` was visited by the most recent traversal. */
    hasPathTo(v: number): boolean {
      return this.marked[v];
    }

    /** Topological sort (DFS‑based) – assumes the graph is a DAG. */
    topSort() {
      let ret = '<ul>';
      const stack: number[] = [];
      const visited: boolean[] = Array(this.vertices).fill(false);

      for (let i = 0; i < this.vertices; i++) {
        if (!visited[i]) {
          this.topSortHelper(i, visited, stack);
        }
      }

      for (const idx of stack) {
        if (idx) {
          ret += `<li>${this.vertexList[idx]}</li>`;
        }
      }
      ret += '</ul>';
      return ret;
    }

    topSortHelper(v: number, visited: boolean[], stack: number[]) {
      visited[v] = true;
      if (this.adj[v]) {
        this.adj[v].forEach((w) => {
          if (!visited[w]) {
            this.topSortHelper(w, visited, stack);
          }
        });
      }
      stack.push(v);
    }
  }

  function startup() {
    const exampleDiv = document.getElementById('example') as HTMLDivElement;
    const textTextArea = document.getElementById('text') as HTMLTextAreaElement;
    const outputDiv = document.getElementById('output') as HTMLDivElement;
    const ex4Div = document.getElementById('ex4');

    if (exampleDiv && textTextArea && outputDiv && ex4Div) {
      const g = new Graph(5);
      g.addEdge(0, 1);
      g.addEdge(0, 2);
      g.addEdge(1, 3);
      g.addEdge(2, 4);
      g.vertexList = ['0', '1', '2', '3', '4'];
      exampleDiv.innerHTML = g.showGraphOld();
      //g.dfs(0);
      exampleDiv.innerHTML += '<p>Breadth First Search:</p>' + g.bfs(0);

      let vertex = 4;
      let paths = g.pathTo(vertex);
      let ret = '<p>Shortest path from 0 to 4</p><p>';
      if (paths) {
        while (paths.length > 0) {
          ret += paths.length > 1 ? `${paths.pop()} - ` : paths.pop();
        }
      }
      ret += '</p>';
      exampleDiv.innerHTML += ret;

      const g2 = new Graph(6);
      g2.addEdge(1, 2);
      g2.addEdge(2, 5);
      g2.addEdge(1, 3);
      g2.addEdge(1, 4);
      g2.addEdge(0, 1);
      g2.vertexList = [
        'CS1',
        'CS2',
        'Data Structures',
        'Assembly Language',
        'Operating Systems',
        'Algorithms',
      ];
      exampleDiv.innerHTML +=
        '<p>Topological Graph:</p>' + g2.showGraph() + g2.topSort();
      textTextArea.value = g2.saveFormat();

      document
        .getElementById('fileLoad')
        ?.addEventListener('change', (event) => {
          const target = event.target as HTMLInputElement;
          const fr = new FileReader();

          fr.onload = () => {
            console.log('results', fr.result);
            const uploadGraph = createGraphFromText(fr.result as string);
            if (uploadGraph) {
              outputDiv.innerHTML = uploadGraph.showGraph();
            }
          };
          if (target.files?.[0]) fr.readAsText(target.files[0]);
        });

      const localArea = new Graph(8);
      localArea.vertexList = [
        'Reedham',
        'Purley',
        'Coulsdon Town',
        'Coulsdon South',
        'Caterham',
        'Purley Oaks',
        'South Croydon',
        'East Croydon',
      ];
      localArea.addEdge(0, 1);
      localArea.addEdge(0, 2);
      localArea.addEdge(1, 3);
      localArea.addEdge(1, 4);
      localArea.addEdge(1, 5);
      localArea.addEdge(5, 6);
      localArea.addEdge(6, 7);
      ex4Div.innerHTML = localArea.showGraph();

      const vertex2 = 7;
      ex4Div.innerHTML +=
        '<legend>Exercise 5</legend><p>Breadth First Search:</p>' +
        localArea.bfs(0);
      const paths2 = localArea.pathTo(vertex2);
      //console.log('has path to 7', localArea.hasPathTo(vertex));
      //console.log('paths',paths);
      let ret2 = '<p>Shortest path from Reedham to East Croydon</p><p>';
      if (paths2) {
        while (paths2.length > 0) {
          const idx = paths2.pop() as number;
          ret2 +=
            paths2.length > 1
              ? `${localArea.vertexList[idx]} - `
              : localArea.vertexList[idx];
        }
      }
      ret2 += '</p>';
      ex4Div.innerHTML += ret2;
      localArea.marked = [];
      localArea.dfs(0);
    }
  }

  function download() {
    const element = document.createElement('a');
    const textTextArea = document.getElementById('text') as HTMLTextAreaElement;
    const fileNameInput = document.getElementById(
      'filename'
    ) as HTMLInputElement;

    if (textTextArea && fileNameInput) {
      const text = textTextArea.value;
      element.setAttribute(
        'href',
        'data:text/plain;charset=utf-8,' + encodeURIComponent(text)
      );
      element.setAttribute('download', fileNameInput.value);

      element.style.display = 'none';
      document.body.appendChild(element);

      element.click();
      document.body.removeChild(element);
    }
  }

  /** Re‑creates a Graph instance from the file upload text. */
  function createGraphFromText(uploadText: string): Graph | undefined {
    const split = uploadText.split('\n');
    if (split.length > 0) {
      const verticesList = split[0].split(',');
      const uploadGraph = new Graph(verticesList.length);
      uploadGraph.vertexList = verticesList;

      for (let i = 1; i < split.length; i++) {
        if (split[i].length > 0) {
          const s = split[i].split(',');
          uploadGraph.addEdge(parseInt(s[0]), parseInt(s[1]));
        }
      }
      return uploadGraph;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    startup();
    document.getElementById('download')?.addEventListener('click', download);
  });
</script>
