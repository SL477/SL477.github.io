---
import DefaultModified from '../../layouts/default_modified.astro';
import tomPic from '../../assets/tom.jpg';
import Picture from 'astro/components/Picture.astro';
const title = 'Profile Card';
// const last_modified_at = 2025 - 11 - 25;
const css_file = 'profileCard.css';
---

<DefaultModified title={title} css_file={css_file}>
  <!-- For Frontend Mentor -->
  <div class="pc-container">
    <div class="pc-container-top"></div>
    <Picture
      src={tomPic}
      alt="Tom."
      formats={['jpg', 'webp']}
      loading="eager"
      class="pc-img"
      width={100}
      height={100}
    />

    <div class="pc-header">
      <h1>Tom Fishwick</h1>
      <span>35</span>
    </div>

    <p class="pc-location">London</p>

    <div class="pc-stats">
      <div>
        <span>20</span>
        <span>Followers</span>
      </div>
      <div>
        <span>1K</span>
        <span>Likes</span>
      </div>
      <div>
        <span>1.4K</span>
        <span>Photoes</span>
      </div>
    </div>
  </div>
</DefaultModified>
