---
import Page from '../../layouts/page.astro';
const frontmatter = {
  title: 'QR Code',
  last_modified_at: '2025-02-09',
  image: {
    path: '/assets/images/qrcode_link477_blue.png',
    height: 419,
    width: 419,
    alt: 'link477.com',
  },
};
---

<style>
  .center {
    display: block;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .card {
    background-color: #fff;
    padding: 5px;
    max-width: 426px;
    border-radius: 5%;

    @media screen and (width < 426px) {
      overflow-x: scroll;
    }
  }

  .card-text {
    font-size: 15px;
    color: #7b879d;
    display: block;
  }

  .qr-pic > img {
    max-height: 419px;
    max-width: 419px;
    height: auto;
    width: auto;
    background-color: #1f3251;
    border-radius: 5%;
  }
</style>

<Page frontmatter={frontmatter}>
  <div class="center card">
    <a href="https://link477.com" target="_blank" rel="noopener noreferrer">
      <picture class="center qr-pic">
        <source
          srcset="/assets/images/qrcode_link477_blue.webp"
          type="image/webp"
        />
        <source
          srcset="/assets/images/qrcode_link477_blue.png"
          type="image/png"
        />
        <img src="/assets/images/qrcode_link477_blue.png" alt="link477.com" />
      </picture>
    </a>
    <h2>
      Visit <a
        href="https://link477.com"
        target="_blank"
        rel="noopener noreferrer">Link477.com</a
      >
    </h2>
    <p class="card-text">
      Scan the QR code to visit <a
        href="https://link477.com"
        target="_blank"
        rel="noopener noreferrer">Link477.com</a
      >
    </p>
  </div>

  <!--I made this as part of the QR code FrontEnd Mentor challenge-->
</Page>
