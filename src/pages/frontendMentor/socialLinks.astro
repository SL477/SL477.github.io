---
import DefaultModified from '../../layouts/default_modified.astro';
import site from '../../content/site.json';
const title = 'Social Links';
const last_modified_at = 2025 - 11 - 26;
const css_file = 'socialLinks.css';
---

<DefaultModified title={title} css_file={css_file}>
  <!-- For Frontend Mentor -->

  <div class="sl-container">
    <picture class="sl-img">
      <source srcset="/assets/images/tom.webp" type="image/webp" />
      <source srcset="/assets/images/tom.jpg" type="image/jpg" />
      <img
        src="/assets/images/tom.jpg"
        alt="Tom."
        width="100"
        height="100"
        fetchpriority="high"
      />
    </picture>

    <h1>Tom Fishwick</h1>
    <p>London, United Kingdom</p>
    <p>{site.description}</p>
    <ul>
      {
        site.github_username && (
          <li>
            <a href={`https://github.com/${site.github_username}`} rel="me">
              GitHub
            </a>
          </li>
        )
      }
      {
        site.frontendmentor_link && (
          <li>
            <a href={site.frontendmentor_link} rel="me">
              Frontend Mentor
            </a>
          </li>
        )
      }
      {
        site.linkedin_username && (
          <li>
            <a
              href={`https://www.linkedin.com/in/${site.linkedin_username}`}
              rel="me"
            >
              LinkedIn
            </a>
          </li>
        )
      }
      {
        site.twitter_username && (
          <li>
            <a
              href={`https://www.twitter.com/${site.twitter_username}`}
              rel="me"
            >
              Twitter
            </a>
          </li>
        )
      }
    </ul>
  </div>
</DefaultModified>
