---
import Page from '../../layouts/page.astro';
const frontmatter = {
  title: 'Model Railway Pics',
  last_modified_at: '2025-05-05',
  css_file: 'modelRailway.css',
};

const modelRailPics = [
  {
    src: '/assets/images/HogwartsExpress2.jpg',
    alt: 'Hogwarts Express',
  },
  {
    src: '/assets/images/GamesShop.jpg',
    alt: 'Games Shop',
  },
  {
    src: '/assets/images/Platform934.jpg',
    alt: 'Platform 9 3/4 with train',
  },
  {
    src: '/assets/images/Platform934NoTrain.jpg',
    alt: 'Platform 9 3/4',
  },
  {
    src: '/assets/images/cargoTrain.jpg',
    alt: 'Cargo Train',
  },
  {
    src: '/assets/images/emmet.jpg',
    alt: 'Emmet',
  },
];
---

<Page frontmatter={frontmatter}>
  <div class="carousel">
    <ul>
      {
        modelRailPics.map((pic) => (
          <li>
            <img src={pic.src} alt={pic.alt} width="544" height="408" />
          </li>
        ))
      }
    </ul>
  </div>
</Page>
