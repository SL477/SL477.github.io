---
import '../../../public/assets/css/colorGrid.css';
import Page from '../../layouts/page.astro';
const frontmatter = {
  title: 'Colour Grid',
  js_file: {
    path: 'colorGrid.js',
    defer: true
  }
};
---

<Page frontmatter={frontmatter}>
  <div id="wrapper">
    <canvas id="canvas" width="280" height="280" class="center"></canvas>
    <div class="center controls">
      <button
        data-colour="White"
        class="button-cls white"
        aria-label="white"
        type="button"></button>
      <button
        data-colour="Blue"
        class="button-cls blue"
        aria-label="blue"
        type="button"></button>
      <button
        data-colour="Green"
        class="button-cls green"
        aria-label="green"
        type="button"></button>
      <button
        data-colour="Purple"
        class="button-cls purple"
        aria-label="purple"
        type="button"></button>
      <button
        data-colour="#e6e600"
        class="button-cls yellow"
        aria-label="yellow"
        type="button"></button>
      <button
        data-colour="Red"
        class="button-cls red"
        aria-label="red"
        type="button"></button>
    </div>
    <p id="NumMoves" class="center">Number of Moves: 0</p>
    <button id="restart" class="btn button center" type="button">
      Restart</button
    >
    <a href="/colorGridGame" class="center"
      ><img src="/assets/images/home.png" alt="Home" id="home" /></a
    >
  </div>
</Page>
