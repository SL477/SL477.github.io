---
import '../../../public/assets/css/colorGrid.css';
import Page from '../../layouts/page.astro';
const frontmatter = {
  title: 'Colour Grid - About',
};
---

<Page frontmatter={frontmatter}>
  <div id="wrapper">
    <h2 class="center">How to play</h2>
    <p class="center">You start the game controlling the top left cell.</p>
    <img src="/assets/images/BigLogo.png" alt="Logo" class="center" />
    <p class="center">
      Click the coloured buttons to change the colour of the cell<br />
      and any adjacent cells of the same colour. Changing it to the<br />
      same colour as any adjacent cells of that colour will add them<br />
      to the group. Try to turn all of the cells to one colour in as<br />
      few moves as possible.
    </p>
    <a href="/colorGridGame" class="center"
      ><img src="/assets/images/home.png" alt="Home" id="home" /></a
    >
  </div>
</Page>
