---
import Head from '../components/head.astro';
import site from '../content/site.json';
import MainPicture from '../components/mainPicture.astro';
import skills from '../content/skills.json';
import projects from '../content/projects.json';
import certifications from '../content/certifications.json';
import Home from '../components/home.astro';
---

<Home title="Home">
    <h1 class="centertext">Thomas Fishwick</h1>
    <div class="top-group">
      {
        site.show_story ? (
          <a href="/story">
            <MainPicture />
          </a>
        ) : (
          <MainPicture />
        )
      }
      <div class="inner-group">
        <h2>Nice to meet you!<br />I'm Tom Fishwick</h2>
        <p>
          My main experience from work is as a developer for
          <a
            href="https://www.elite.com/3e/"
            target="_blank"
            rel="noopener noreferrer">Elite 3E</a
          >
          (VB.Net & SQL) and
          <a
            href="https://www.thomsonreuters.com/content/dam/openweb/documents/pdf/mena/brochures/3e-matter-management-brochure.pdf"
            target="_blank"
            rel="noopener noreferrer">MatterSphere</a
          >
          (C#). This involves creating new screens and workflows and integrating them
          with various APIs. As well as these I have made an ASP.Net site serving
          a Vue.JS application, and various other JavaScript applications.
        </p>

        <p>
          In my spare time I have created various apps in Python, JavaScript,
          React Native and Android. Plus I have some experience in PHP.
        </p>
      </div>
    </div>

    <hr />

    <h2>Skills</h2>
    <div class="skills-container">
      {
        skills.skills
          .filter((s) => !s.hide)
          .map((s) => (
            <div class="skills-card">
              <h3>{s.name}</h3>
              <p>
                {s.years} Year{s.years > 1 && 's'} Experience
              </p>
            </div>
          ))
      }
    </div>

    <hr />

    <h2>Projects</h2>
    <div class="project-container">
      {
        projects.projects.map((project) => (
          <div class="project-tile">
            <picture class="borderimage">
              <source
                srcset={`/assets/images/${project.picture}.webp`}
                type="image/webp"
              />
              <source
                srcset={`/assets/images/${project.picture}.jpg`}
                type="image/jpeg"
              />
              <img
                src={`/assets/images/${project.picture}.jpg`}
                alt={project.picture_text}
                class="borderimage"
                loading="lazy"
                width={project.picture_width}
                height={project.picture_height}
              />
            </picture>

            <details>
              <summary>{project.name}</summary>
              <pre class="project-pre" set:html={project.description} />
            </details>
            {(project.url || project.repository) && (
              <>
                <br />
                {project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    Live Link
                  </a>
                )}
                {project.url && project.repository && <span> </span>}
                {project.repository && (
                  <a
                    href={project.repository}
                    target="_blank"
                    rel="noreferrer noopener"
                  >
                    Source
                  </a>
                )}
              </>
            )}
          </div>
        ))
      }
    </div>

    <hr />

    <h2>Certifications</h2>
    <div class="project-container">
      {
        certifications.certifications.map((cert) => (
          <a
            href={`https://www.credly.com/badges/${cert.id}/public_url`}
            target="_blank"
            rel="noreferrer noopener"
          >
            <picture>
              <source
                srcset={`/assets/images/${cert.src}.webp`}
                type="image/webp"
              />
              <source
                srcset={`/assets/images/${cert.src}.png`}
                type="image/png"
              />
              <img
                src={`/assets/images/${cert.src}.png`}
                alt={cert.name}
                width="150"
                height="150"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
        ))
      }
    </div>

    <hr />

    <h2>Contact</h2>

    <div id="contact-container">
      <p id="contact-text">
        I would love to hear about your company and how I could help. Please
        fill in the form, and I'll get back to you as soon as possible.
      </p>

      <form
        action="https://link477255648240.wordpress.com/contact/"
        method="post"
        id="contact-form"
      >
        <div class="mb-3 row">
          <label for="g32-name" class="col-form-label">Name:</label>
          <div class="col-input">
            <input
              type="text"
              name="g32-name"
              required
              id="g32-name"
              class="form-control"
            />
          </div>
        </div>
        <div class="mb-3 row">
          <label for="g32-email" class="col-form-label">Email:</label>
          <div class="col-input">
            <input
              type="email"
              name="g32-email"
              required
              id="g32-email"
              class="form-control"
            />
          </div>
        </div>
        <div class="mb-3 row">
          <label for="g32-message" class="col-form-label">Message:</label>
          <div class="col-input">
            <textarea
              name="g32-message"
              id="g32-message"
              class="form-control"
              rows="2"></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-primary mb-3">Send Message</button>
      </form>
    </div>
</Home>